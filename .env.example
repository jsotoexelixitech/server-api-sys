# --- Servidor ---
# Puerto 3002: pagos-api usa 3001 (banco). No compartir el mismo PORT.
PORT=3002
NODE_ENV=development
SWAGGER_PATH=docs
# true = muestra srv001/localhost en el desplegable de servidores (dev). false en doc pública HTTPS.
# SWAGGER_SHOW_INTERNAL_SERVERS=true

# Prefijo público HTTPS — mismo patrón en prod y QA (no cambiar el prefijo)
# Local: vacío → http://localhost:3002/docs
# srv001 prod: /nest-api-docs → https://cierrelmds.exelixitech.com/nest-api-docs/docs
# Nexus QA:     /nest-api-docs → https://nexusqa.exelixitech.com/nest-api-docs/docs
PUBLIC_API_PREFIX=/nest-api-docs
# Prod (cierrelmds):
# PUBLIC_API_ORIGIN=https://cierrelmds.exelixitech.com
# QA Nexus:
PUBLIC_API_ORIGIN=https://nexusqa.exelixitech.com

# --- SQL Server (deben ser los MISMOS valores del .env del Express viejo) ---
SERVER_BD=
NAME_BD=
USER_BD=
PASSWORD_BD=

# --- Pool mssql ---
MSSQL_REQUEST_TIMEOUT=300000
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_ENABLE_ARITH_ABORT=true
# SP Nexus para calculate-plan-coberturas (default sp_calculo_auto_nexus)
# MSSQL_SP_CALCULO_AUTO_NEXUS=sp_calculo_auto_nexus
# SP Nexus catálogo recargos RCV (default sp_get_recargos_rcv_nexus)
# MSSQL_SP_GET_RECARGOS_RCV_NEXUS=sp_get_recargos_rcv_nexus

# --- CORS ---
# QA Nexus: incluir origen del portal si no usa *
# CORS_ORIGIN=https://nexusqa.exelixitech.com,http://localhost:5183
CORS_ORIGIN=*

# --- Auth nest-api (token para módulos / integradores) ---
# false = rutas protegidas aceptan apikey/Bearer opcional (QA interno actual)
NEST_AUTH_ENABLED=true
# true en cierrelmds: canje/refresh solo HTTPS (127.0.0.1 exento)
NEST_AUTH_REQUIRE_HTTPS=false
NEST_AUTH_STRICT_APIKEY=false
# Producción: generar secreto >= 32 chars (openssl rand -hex 32)
NEST_JWT_SECRET=
NEST_ACCESS_TTL_SEC=900
NEST_REFRESH_TTL_SEC=604800
NEST_TOKEN_SLIDE_SEC=300

# --- PostgreSQL auth (API keys + tokens) — srv001 192.168.8.120 ---
# Esquema: nest_auth · BD recomendada: nest_api
# Codificar caracteres especiales en password (* → %2A)
# NEST_PG_DATABASE_URL=postgresql://jsoto:PASSWORD@192.168.8.120:5432/nest_api?schema=nest_auth
# Panel admin: /admin/ · header X-Admin-Token
NEST_PG_DATABASE_URL=
NEST_ADMIN_TOKEN=

# --- Emisión RCV ---
# local = INSERT directo Sis2000 (default). external = HTTP La Mundial QA con fallback local.
EMISSION_SOURCE=local
# Plan usado en validateEmissionAuto si el body no trae `plan` (validación pre-plan en Formulario Exélixi).
LAMUNDIAL_PLAN_DEFAULT=RCVBAS
LAMUNDIAL_PRODUCTOR=80080
LAMUNDIAL_CUSUARIO=4
# Tipo pago pago móvil en MABANCO_DESTINO (SysIP usa 3). Solo si maclient_api no trae ctipopago.
LAMUNDIAL_CTIPOPAGO=3
# URL base PDF póliza — una de las dos (mismo valor que Express legacy URLPoliza)
POLICY_PDF_URL=
URLPoliza=https://qaapi.lamundialdeseguros.com/sis2000/poliza/
# Comprobante ingreso de caja (PDF Sis2000) — alias legacy URLingreso_caja
URLingreso_caja=https://qaapi.lamundialdeseguros.com/sis2000/ingreso_caja/
# PDF estático Club Arys (cobertura ccober=15 ramo 18)
ARYS_TRADICIONAL_PDF_URL=https://qasys2000.lamundialdeseguros.com/assets/Arys_Tradicional.pdf
ARYS_AUTO_BI_PDF_URL=https://qasys2000.lamundialdeseguros.com/assets/ArysAutoBi.pdf

# --- Módulos partner (integradores externos vía npm) ---
# Solo en .env — NO en ecosystem.config.js (PM2 pisa dotenv y ignora este valor).
# Ej. plantilla interna: @exelixi/partner-api-starter
# Ej. integrador:       @esanchez-exelixitech/partner-api-test
PARTNER_PACKAGES=

# Solo si EMISSION_SOURCE=external (no commitear valores reales):
# EXTERNAL_API_URL_AUTO=
# EXTERNAL_API_KEY=
# EXTERNAL_BASIC_AUTH=

# --- Emisión genérica multi-ramo (product-emission) — NUEVO, AISLADO ---
# Ambiente 100% separado de La Mundial: BD propia + cliente Prisma propio
# (ver prisma-product-emission/schema.prisma). NO comparte BD/esquema con
# NEST_PG_DATABASE_URL (auth) ni con Sis2000. Usa ramos/planes/coberturas
# creados en proyecto-product-builder solo por HTTP (lectura de catálogo).
PRODUCT_BUILDER_API_URL=http://localhost:3001
# Cuenta de servicio: product-builder exige Bearer incluso para lectura (GET /api/products/:id).
PRODUCT_BUILDER_API_EMAIL=
PRODUCT_BUILDER_API_PASSWORD=
# Local (docker): postgresql://postgres:postgres@localhost:5433/product_emission?schema=public
# Nota: usar puerto/BD distintos a los de product-builder (5432) y nest_api (5432 srv001).
PRODUCT_EMISSION_DATABASE_URL=
PRODUCT_EMISSION_DOCS_DIR=temp-product-emission-docs

# --- Correo post-emisión (documentos PDF) ---
# false = endpoint /api/v1/mail/policy-emission responde sent:false sin error HTTP
MAIL_ENABLED=false
# smtp = Nodemailer (plantilla welcome + adjuntos desde URLs). sisip = proxy PHP sendmail_sisip
MAIL_TRANSPORT=smtp
MAIL_AUTO_ON_EMIT=false
# MAIL_DEFAULT_CC=operaciones@lamundialdeseguros.com
SMTP_HOST=mail.lamundialdeseguros.com
SMTP_PORT=25
SMTP_SECURE=false
# Relay interno La Mundial: sin auth (como PHPMailer SMTPAuth=false)
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=info@lamundialdeseguros.com
SMTP_FROM_NAME=La Mundial de Seguros
# SMTP_REPLY_TO=info@lamundialdeseguros.com
# Solo si MAIL_TRANSPORT=sisip (cuerpo/adjuntos los arma PHP Sis2000):
# URL_API_EMAIL=https://qaapi.lamundialdeseguros.com/sis2000/sendmail_sisip/
