# Copiar a: ~/.config/exelixi-nest-partners/tokens.env
#   mkdir -p ~/.config/exelixi-nest-partners
#   cp scripts/partner-tokens.env.example ~/.config/exelixi-nest-partners/tokens.env
#   chmod 600 ~/.config/exelixi-nest-partners/tokens.env
#   nano ~/.config/exelixi-nest-partners/tokens.env
#
# NUNCA commitear este archivo con tokens reales.
# Ideal a largo plazo: UN solo PAT con read:packages en las 3 orgs → rellenar solo TOKEN_DEFAULT.

# Si está definido, se usa para todos los partners que no tengan token propio.
TOKEN_DEFAULT=

# Tokens por scope (solo hace falta si cada proveedor da un PAT distinto)
TOKEN_QUAND_MIND=
TOKEN_ESANCHEZ=
TOKEN_GESTACIO=
